-- logo.ff
-- 4-pointed star, 25x17, ASCII only
-- Colors: # = gold, + = orange, . = bronze

LogoStar = {
  "           .           ",
  "          +++          ",
  "          ###          ",
  "          ###          ",
  "    .     ###     .    ",
  "   +++    ###    +++   ",
  "  +++++   ###   +++++  ",
  " +++++++  ###  +++++++ ",
  "+++++++++ ### +++++++++",
  " +++++++  ###  +++++++ ",
  "  +++++   ###   +++++  ",
  "   +++    ###    +++   ",
  "    .     ###     .    ",
  "          ###          ",
  "          ###          ",
  "          +++          ",
  "           .           ",
}

LogoColors = {
  ["#"] = 0xFFD700,  -- gold (center)
  ["+"] = 0xFF8C00,  -- orange (mid)
  ["."] = 0x8B4513,  -- bronze (edges)
}

LogoCenter = {
  star = {13, 9},  -- x, y в координатах массива
  color = 0xFFFFFF,
}